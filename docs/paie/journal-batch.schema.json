{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myyiel.app/schemas/journal-batch-1.json",
  "title": "myyiel.journal-batch/1",
  "description": "Lot d'écritures transmis par un module métier (paie, notes de frais, stocks…) au module comptable. Intégré en tout ou rien, une seule fois par source.ref.",
  "type": "object",
  "required": ["format", "source", "entries", "totals"],
  "additionalProperties": false,
  "properties": {
    "format":  { "const": "myyiel.journal-batch/1" },
    "company": { "type": "string", "description": "Identifiant de la société destinataire ; refus si différent de la société active." },
    "label":   { "type": "string" },
    "source": {
      "type": "object",
      "required": ["module", "ref"],
      "properties": {
        "module":      { "type": "string", "examples": ["paie", "paie-virement", "paie-declaration", "gta"] },
        "ref":         { "type": "string", "description": "Clé d'idempotence (ex. PAIE-2026-10). Un lot déjà intégré avec la même ref est refusé." },
        "generatedAt": { "type": "string", "format": "date-time" },
        "period":      { "type": "string", "pattern": "^\\d{4}-\\d{2}$" }
      },
      "additionalProperties": true
    },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["journal", "date", "ref", "label", "lines"],
        "properties": {
          "journal":   { "type": "string", "examples": ["PAIE", "BQ1", "OD"] },
          "kind":      { "type": "string", "enum": ["payroll", "payroll-payment", "payroll-declaration", "advance", "loan", "regul"] },
          "date":      { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "pieceDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "ref":       { "type": "string" },
          "label":     { "type": "string" },
          "lines": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object",
              "required": ["account", "debit", "credit"],
              "properties": {
                "account": { "type": "string", "pattern": "^[1-9]\\d{1,11}$", "description": "Compte imputable du plan SYSCOHADA de la société." },
                "label":   { "type": "string" },
                "debit":   { "type": "integer", "minimum": 0 },
                "credit":  { "type": "integer", "minimum": 0 },
                "section": { "type": "string", "description": "Section analytique (classe 9)." },
                "tiers": {
                  "type": ["object", "null"],
                  "required": ["code"],
                  "properties": {
                    "code": { "type": "string", "description": "Matricule salarié = code tiers personnel." },
                    "name": { "type": "string" },
                    "type": { "const": "personnel" },
                    "collective": { "type": "string", "default": "422" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["debit", "credit"],
      "properties": { "debit": { "type": "integer" }, "credit": { "type": "integer" }, "lines": { "type": "integer" } }
    },
    "checksum": { "type": "string", "description": "Empreinte FNV-1a 32 bits (hex) du contenu canonique, voir 03-interface-comptable.md." }
  }
}
