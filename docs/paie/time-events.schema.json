{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myyiel.app/schemas/time-events-1.json",
  "title": "myyiel.time-events/1",
  "description": "Événements de temps (GTA, pointeuse, fichier) consommés par la paie. Le futur module GTA produit ce format ; la paie l'agrège en éléments variables sans changement de moteur.",
  "type": "object",
  "required": ["format", "period", "events"],
  "properties": {
    "format":  { "const": "myyiel.time-events/1" },
    "company": { "type": "string" },
    "period":  { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["matricule", "date", "type", "quantite"],
        "properties": {
          "id":          { "type": "string", "description": "Identifiant source pour le dédoublonnage (recommandé)." },
          "matricule":   { "type": "string" },
          "date":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "type":        { "enum": ["HS1", "HS2", "HS3", "HSN", "ABS_NP", "CONGE", "ABS_MAL", "ABS_AUT", "RETARD"] },
          "quantite":    { "type": "number", "exclusiveMinimum": 0, "description": "Heures pour HS*, jours pour ABS*/CONGE, minutes pour RETARD." },
          "commentaire": { "type": "string" },
          "approuve":    { "type": "boolean", "default": true }
        }
      }
    }
  }
}
